{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "VisualContainer5",
  "position": { "x": 20, "y": 225, "z": 5000, "height": 260, "width": 400 },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "DimCustomer" } },
                  "Property": "LoyaltySegment"
                }
              },
              "queryRef": "DimCustomer.LoyaltySegment",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "FactSales" } },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "FactSales.Total Revenue"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": { "SourceRef": { "Entity": "FactSales" } },
                "Property": "Total Revenue"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "objects": {
      "legend": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "position": { "expr": { "Literal": { "Value": "'Bottom'" } } }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "labelStyle": { "expr": { "Literal": { "Value": "'Percent of total'" } } }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'Revenue by Loyalty Segment'" } } },
            "fontSize": { "expr": { "Literal": { "Value": "14D" } } }
          }
        }
      ]
    }
  }
}
