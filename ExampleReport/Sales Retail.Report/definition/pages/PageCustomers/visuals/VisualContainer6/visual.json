{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "VisualContainer6",
  "position": { "x": 430, "y": 225, "z": 6000, "height": 260, "width": 400 },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "DimCustomer" } },
                  "Property": "AgeGroup"
                }
              },
              "queryRef": "DimCustomer.AgeGroup",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "FactSales" } },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "FactSales.Total Revenue"
            }
          ]
        }
      }
    },
    "objects": {
      "legend": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "false" } } }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } }
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "axisType": { "expr": { "Literal": { "Value": "'Categorical'" } } }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'Revenue by Age Group'" } } },
            "fontSize": { "expr": { "Literal": { "Value": "14D" } } }
          }
        }
      ]
    }
  }
}
