{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "VisualContainer7",
  "position": { "x": 840, "y": 225, "z": 7000, "height": 260, "width": 420 },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "DimPaymentMethod" } },
                  "Property": "PaymentMethodName"
                }
              },
              "queryRef": "DimPaymentMethod.PaymentMethodName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "FactSales" } },
                  "Property": "Number of Orders"
                }
              },
              "queryRef": "FactSales.Number of Orders"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": { "SourceRef": { "Entity": "FactSales" } },
                "Property": "Number of Orders"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "objects": {
      "legend": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "false" } } }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } }
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "axisType": { "expr": { "Literal": { "Value": "'Categorical'" } } }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'Orders by Payment Method'" } } },
            "fontSize": { "expr": { "Literal": { "Value": "14D" } } }
          }
        }
      ]
    }
  }
}
