{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "VisualContainer8",
  "position": { "x": 20, "y": 510, "z": 8000, "height": 195, "width": 1240 },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "DimStore" } },
                  "Property": "StoreName"
                }
              },
              "queryRef": "DimStore.StoreName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "FactSales" } },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "FactSales.Total Revenue"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": { "SourceRef": { "Entity": "FactSales" } },
                "Property": "Total Revenue"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "objects": {
      "legend": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "false" } } }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'Revenue by Store'" } } },
            "fontSize": { "expr": { "Literal": { "Value": "14D" } } }
          }
        }
      ]
    }
  }
}
