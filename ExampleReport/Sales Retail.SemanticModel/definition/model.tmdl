model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimDate","DimProduct","DimCustomer","DimStore","DimEmployee","DimPaymentMethod","FactSales"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table DimProduct
ref table DimCustomer
ref table DimStore
ref table DimEmployee
ref table DimPaymentMethod
ref table FactSales

ref cultureInfo en-US

