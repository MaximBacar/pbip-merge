/// Employee dimension listing 30 sales associates and store managers across the FNAC network.
table DimEmployee
	lineageTag: ee000000-0000-0000-0000-000000000000

	/// Surrogate primary key of the employee. Joins FactSales[EmployeeKey]. Hidden.
	column EmployeeKey
		dataType: int64
		isHidden
		lineageTag: ee010000-0000-0000-0000-000000000000
		summarizeBy: none
		sourceColumn: EmployeeKey

		annotation SummarizationSetBy = User

	/// Business-facing employee number (EMP-001..EMP-030).
	column EmployeeCode
		dataType: string
		lineageTag: ee020000-0000-0000-0000-000000000000
		summarizeBy: none
		sourceColumn: EmployeeCode

		annotation SummarizationSetBy = User

	/// Full display name (First Last) of the employee.
	column EmployeeName
		dataType: string
		lineageTag: ee030000-0000-0000-0000-000000000000
		summarizeBy: none
		sourceColumn: EmployeeName

		annotation SummarizationSetBy = User

	/// Sales department (e.g. Books, Electronics, Media, Management).
	column Department
		dataType: string
		lineageTag: ee040000-0000-0000-0000-000000000000
		summarizeBy: none
		sourceColumn: Department

		annotation SummarizationSetBy = User

	/// Job role (Sales Associate, Cashier, Store Manager).
	column JobRole
		dataType: string
		lineageTag: ee050000-0000-0000-0000-000000000000
		summarizeBy: none
		sourceColumn: JobRole

		annotation SummarizationSetBy = User

	/// Date the employee joined FNAC.
	column HireDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ee060000-0000-0000-0000-000000000000
		summarizeBy: none
		sourceColumn: HireDate

		annotation SummarizationSetBy = User

